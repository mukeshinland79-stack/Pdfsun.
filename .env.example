# ===================================================
# PDFSun Enterprise Security & Environment Declaration
# ===================================================

# 1. AI API Credentials
# GEMINI_API_KEY: Required for Gemini AI API calls (OCR, summarize, chat, translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Application & Hosting URLs & Analytics
APP_URL="https://www.pdfsun.in"
VITE_GA_MEASUREMENT_ID="G-VKEKHR7SK8"

# 3. Admin Cloaking & Zero-Trust Secrets
# ADMIN_SECRET_KEY: Secret key required for Owner/Admin session tokens and endpoints.
ADMIN_SECRET_KEY="REPLACE_WITH_STRONG_ADMIN_SECRET_KEY"

# 4. Storage & Retention Policies
# TEMP_STORAGE_RETENTION_MIN: Max retention time for processed temp files (in minutes)
TEMP_STORAGE_RETENTION_MIN=20
# MAX_STORAGE_USAGE_PERCENT_TRIGGER: SSD usage percentage to trigger emergency purge
MAX_STORAGE_USAGE_PERCENT_TRIGGER=70

# 6. Razorpay Subscriptions, Banking & Automated Settlement (Server-Side Only - Private)
BANK_ACCOUNT_HOLDER="YOUR_ACCOUNT_HOLDER_NAME"
BANK_NAME="YOUR_BANK_NAME"
BANK_ACCOUNT_NO="YOUR_BANK_ACCOUNT_NUMBER"
BANK_IFSC="YOUR_BANK_IFSC_CODE"
BANK_BRANCH="YOUR_BANK_BRANCH"
BANK_UPI_ID="YOUR_BUSINESS_UPI_ID"
RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"
RAZORPAY_ENTERPRISE_PLAN_ID="YOUR_RAZORPAY_ENTERPRISE_PLAN_ID"
RAZORPAY_BUSINESS_PLAN_ID="YOUR_RAZORPAY_BUSINESS_PLAN_ID"
RAZORPAY_PRO_YEARLY_PLAN_ID="YOUR_RAZORPAY_PRO_YEARLY_PLAN_ID"
RAZORPAY_PRO_MONTHLY_PLAN_ID="YOUR_RAZORPAY_PRO_MONTHLY_PLAN_ID"
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# 7. Banking-Grade MFA & SMS / Email OTP Dispatch Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PDFSun Security <security@pdfsun.in>"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_JWT_SECRET"

# 8. Facebook OAuth Login Verification (Meta App Credentials)
# Leave unset to enforce HTTP 503 fail-closed mode.
FACEBOOK_APP_ID=""
VITE_FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# 9. WebAuthn / Passkey Relying Party Configuration (Optional Overrides)
# Derived dynamically from APP_URL / verified origins when omitted.
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGINS=""

# 10. Shared Distributed State (Required for Multi-Instance Cloud Run or Vercel Serverless)
# Enables cross-instance rate limiting and token revocation via Upstash Redis REST API.
# When omitted, process-local in-memory fallback is used (not globally consistent across replicas).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 11. Additional Server Auth, Owner Identity & CORS Configuration (Production / Optional)
# Distinct JWT signing secrets & owner governance controls referenced by server.ts / src/server/*
ADMIN_JWT_SECRET=""
OWNER_JWT_SECRET=""
OWNER_EMAILS=""
OWNER_BOOTSTRAP_PASSWORD=""
OWNER_MFA_PHONE=""
ALLOWED_ORIGINS=""
TRUST_CLOUDFLARE_EDGE=""

# 12. Owner Payout Bank Overrides (Server-Side Only — Optional Overrides for Section 6)
OWNER_PAYOUT_ACCOUNT_HOLDER=""
OWNER_PAYOUT_BANK_NAME=""
OWNER_PAYOUT_ACCOUNT_NUMBER=""
OWNER_PAYOUT_IFSC=""
OWNER_PAYOUT_BRANCH=""
OWNER_PAYOUT_UPI_ID=""

# 13. Additional Payment, Storage & Email Provider Integrations (Optional)
RAZORPAY_PLAN_ID=""
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_SECURE=""

# 14. Client Build / Runtime & Server Binding Overrides (Optional / Dev-Only)
VITE_FIREBASE_API_KEY=""
HOST=""
APP_PORT=""
DEFAULT_APP_PORT=""
NGINX_PORT=""
PDFSUN_DISABLE_AUTO_LISTEN=""
PDFSUN_SUPPORT_STORE_DIR=""

