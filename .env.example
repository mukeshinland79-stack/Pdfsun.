# ===================================================
# PDFSun Enterprise Security & Environment Declaration
# ===================================================

# 1. AI API Credentials
# GEMINI_API_KEY: Required for Gemini AI API calls (OCR, summarize, chat, translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Application & Hosting URLs & Analytics
APP_URL="https://www.pdfsun.in"
VITE_GA_MEASUREMENT_ID="G-VKEKHR7SK8"

# 3. Admin Cloaking & Zero-Trust Secrets
# ADMIN_SECRET_KEY: Secret key required for Owner/Admin session tokens and endpoints.
ADMIN_SECRET_KEY="REPLACE_WITH_STRONG_ADMIN_SECRET_KEY"

# 4. Storage & Retention Policies
# TEMP_STORAGE_RETENTION_MIN: Max retention time for processed temp files (in minutes)
TEMP_STORAGE_RETENTION_MIN=20
# MAX_STORAGE_USAGE_PERCENT_TRIGGER: SSD usage percentage to trigger emergency purge
MAX_STORAGE_USAGE_PERCENT_TRIGGER=70

# 6. Razorpay Subscriptions, Banking & Automated Settlement (Server-Side Only - Private)
BANK_ACCOUNT_HOLDER="YOUR_ACCOUNT_HOLDER_NAME"
BANK_NAME="YOUR_BANK_NAME"
BANK_ACCOUNT_NO="YOUR_BANK_ACCOUNT_NUMBER"
BANK_IFSC="YOUR_BANK_IFSC_CODE"
BANK_BRANCH="YOUR_BANK_BRANCH"
BANK_UPI_ID="YOUR_BUSINESS_UPI_ID"
RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"
RAZORPAY_ENTERPRISE_PLAN_ID="YOUR_RAZORPAY_ENTERPRISE_PLAN_ID"
RAZORPAY_BUSINESS_PLAN_ID="YOUR_RAZORPAY_BUSINESS_PLAN_ID"
RAZORPAY_PRO_YEARLY_PLAN_ID="YOUR_RAZORPAY_PRO_YEARLY_PLAN_ID"
RAZORPAY_PRO_MONTHLY_PLAN_ID="YOUR_RAZORPAY_PRO_MONTHLY_PLAN_ID"
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# 7. Banking-Grade MFA & SMS / Email OTP Dispatch Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PDFSun Security <security@pdfsun.in>"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_JWT_SECRET"
