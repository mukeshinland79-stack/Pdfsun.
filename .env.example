# ===================================================
# PDFSun Enterprise Security & Environment Declaration
# ===================================================

# 1. AI API Credentials
# GEMINI_API_KEY: Required for Gemini AI API calls (OCR, summarize, chat, translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Application & Hosting URLs & Analytics
APP_URL="https://pdfsun.in"
VITE_GA_MEASUREMENT_ID="G-VKEKHR7SK8"

# 3. Admin Cloaking & Zero-Trust Secrets
# ADMIN_SECRET_KEY: Secret key required for Owner/Admin session tokens and endpoints.
ADMIN_SECRET_KEY="pdfsun_owner_super_secret_key_2026"

# 4. Storage & Retention Policies
# TEMP_STORAGE_RETENTION_MIN: Max retention time for processed temp files (in minutes)
TEMP_STORAGE_RETENTION_MIN=20
# MAX_STORAGE_USAGE_PERCENT_TRIGGER: SSD usage percentage to trigger emergency purge
MAX_STORAGE_USAGE_PERCENT_TRIGGER=70

# 6. Banking & Automated Settlement Variables (Server-Side Only - Private)
