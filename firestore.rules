rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------------
    // Global Fortress Safety Net: Default-deny all unmapped collections
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn()
        && request.auth.token.email == "mukeshinland79@gmail.com"
        && request.auth.token.email_verified == true;
    }
    
    function isOwner(emailOrUid) {
      return isSignedIn() && (
        request.auth.uid == emailOrUid ||
        request.auth.token.email == emailOrUid
      );
    }

    function isOwnerEmail(targetEmail) {
      return isSignedIn() && request.auth.token.email == targetEmail;
    }

    // ------------------------------------------------------------------------
    // Distributed Rate Limits & Quotas (Server-Only Access)
    // ------------------------------------------------------------------------
    match /daily_ai_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /rate_limits/{rateLimitId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // Feedback & Comments Collection
    // ------------------------------------------------------------------------
    match /feedback_comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['toolId', 'rating', 'comment', 'createdAt'])
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isSignedIn() && (
        isOwnerAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email
      );
    }

    // Quick Tool Ratings Collection (Bounded schema & +1 monotonic increment validation)
    match /quick_feedback/{toolId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['toolId', 'likes', 'dislikes'])
                    && request.resource.data.keys().hasOnly(['toolId', 'likes', 'dislikes'])
                    && request.resource.data.toolId is string
                    && request.resource.data.toolId == toolId
                    && toolId.size() >= 1
                    && toolId.size() <= 100
                    && request.resource.data.likes is int
                    && request.resource.data.dislikes is int
                    && (
                      (request.resource.data.likes == 1 && request.resource.data.dislikes == 0) ||
                      (request.resource.data.likes == 0 && request.resource.data.dislikes == 1)
                    );
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
                    && request.resource.data.likes is int
                    && request.resource.data.dislikes is int
                    && request.resource.data.likes >= resource.data.likes
                    && request.resource.data.dislikes >= resource.data.dislikes
                    && (request.resource.data.likes - resource.data.likes) + (request.resource.data.dislikes - resource.data.dislikes) == 1;
      allow delete: if isOwnerAdmin();
    }

    // Tool Feedback Ratings Collection
    match /tool_feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['toolId', 'rating', 'comment', 'timestamp'])
                    && request.resource.data.toolId is string
                    && request.resource.data.toolId.size() >= 1
                    && request.resource.data.toolId.size() <= 100
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 5000;
      allow update, delete: if isSignedIn() && (
        isOwnerAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email
      );
    }

    // Today in History Engagement Metrics & Popular Content (Bounded schema & increment validation)
    match /history_engagement/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['eventId', 'views', 'reads', 'likes', 'shares', 'downloads', 'engagementScore', 'lastUpdated'])
                    && request.resource.data.keys().hasOnly(['eventId', 'headline', 'year', 'category', 'tag', 'dateKey', 'views', 'reads', 'likes', 'shares', 'downloads', 'engagementScore', 'lastUpdated'])
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId == eventId
                    && eventId.size() >= 1
                    && eventId.size() <= 160
                    && request.resource.data.views is int && request.resource.data.views >= 0 && request.resource.data.views <= 1
                    && request.resource.data.reads is int && request.resource.data.reads >= 0 && request.resource.data.reads <= 1
                    && request.resource.data.likes is int && request.resource.data.likes >= 0 && request.resource.data.likes <= 1
                    && request.resource.data.shares is int && request.resource.data.shares >= 0 && request.resource.data.shares <= 1
                    && request.resource.data.downloads is int && request.resource.data.downloads >= 0 && request.resource.data.downloads <= 1
                    && request.resource.data.engagementScore is int && request.resource.data.engagementScore >= 1 && request.resource.data.engagementScore <= 8
                    && request.resource.data.lastUpdated is string && request.resource.data.lastUpdated.size() <= 64;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'reads', 'likes', 'shares', 'downloads', 'engagementScore', 'lastUpdated', 'headline', 'year', 'category', 'tag', 'dateKey'])
                    && request.resource.data.views is int && request.resource.data.views >= resource.data.views && request.resource.data.views <= resource.data.views + 1
                    && request.resource.data.reads is int && request.resource.data.reads >= resource.data.reads && request.resource.data.reads <= resource.data.reads + 1
                    && request.resource.data.likes is int && request.resource.data.likes >= resource.data.likes && request.resource.data.likes <= resource.data.likes + 1
                    && request.resource.data.shares is int && request.resource.data.shares >= resource.data.shares && request.resource.data.shares <= resource.data.shares + 1
                    && request.resource.data.downloads is int && request.resource.data.downloads >= resource.data.downloads && request.resource.data.downloads <= resource.data.downloads + 1
                    && request.resource.data.engagementScore is int && request.resource.data.engagementScore >= resource.data.engagementScore && request.resource.data.engagementScore <= resource.data.engagementScore + 8;
      allow delete: if isOwnerAdmin();
    }

    // ------------------------------------------------------------------------
    // Financial Collections (100% Server-Only Writes, Read Restricted by Identity)
    // ------------------------------------------------------------------------

    // Verified Payments Collection (Sensitive financial records - Read by owner/admin, created/updated server-side only)
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.userEmail == request.auth.token.email ||
        isOwnerAdmin()
      );
      allow create, update, delete: if false;
    }

    // Transactions Collection (Idempotent payment records - Managed strictly server-side)
    match /transactions/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.userEmail == request.auth.token.email ||
        isOwnerAdmin()
      );
      allow create, update, delete: if false;
    }

    // Active User Subscriptions - Managed strictly server-side
    match /user_subscriptions/{userId} {
      allow read: if isSignedIn() && (
        userId == request.auth.uid ||
        userId == request.auth.token.email ||
        resource.data.userId == request.auth.token.email ||
        isOwnerAdmin()
      );
      allow create, update, delete: if false;
    }

    // User Credits Ledger - Managed strictly server-side
    match /user_credits/{userEmail} {
      allow read: if isSignedIn() && (
        userEmail == request.auth.token.email ||
        userEmail == request.auth.uid ||
        isOwnerAdmin()
      );
      allow create, update, delete: if false;
    }

    // Payment Reconciliation Audit Logs (Admin & Server - Managed strictly server-side)
    match /payment_reconciliations/{reconciliationId} {
      allow read: if isSignedIn() && (
        resource.data.userEmail == request.auth.token.email ||
        isOwnerAdmin()
      );
      allow create, update, delete: if false;
    }

    // Internal Orders Collection (Managed strictly by server-side APIs)
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userEmail == request.auth.token.email ||
        isOwnerAdmin()
      );
      allow create, update, delete: if false;
    }

    // Owner Payment Audit Logs (Admin Panel) strictly per AGENTS_md:
    // Read restricted to owner mukeshinland79@gmail.com.
    // Untrusted client-side writes are strictly forbidden (immutable & tamper-proof).
    // All creation, updates, and deletions by client SDKs are denied (write: false).
    match /owner_payment_audit_logs/{logId} {
      allow read: if isOwnerAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // Daily Knowledge Hub & Today in History (Public Read, Owner-Only Write)
    // ------------------------------------------------------------------------
    match /daily_history/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    match /history_events/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    match /knowledge_hub/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    match /daily_chronicles/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }
  }
}
